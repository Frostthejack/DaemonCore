{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DaemonCore",
  "version": "0.1.0",
  "identifier": "com.frostthejack.daemoncore",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
"app": {
    "windows": [
      {
        "title": "DaemonCore",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": true,
        "shadow": false,
        "background": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; img-src 'self' asset: data: blob:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-eval';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
